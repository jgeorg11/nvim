# Copy this file to .env and fill in values for local/private adapters.

# CODECOMPANION_INLINE_ADAPTER=local_ollama

# OpenAI-compatible remote endpoint
# CODECOMPANION_OPENAI_URL=
# CODECOMPANION_OPENAI_API_KEY=
# CODECOMPANION_OPENAI_MODEL=openai/gpt-oss-120b

# OpenWebUI-compatible local or private endpoint
# CODECOMPANION_OPENWEBUI_URL=
# CODECOMPANION_OPENWEBUI_API_KEY=
# CODECOMPANION_OPENWEBUI_MODEL=llama-4-maverick

# Ollama local model
# OLLAMA_MODEL=gpt-oss:20b

# LM Studio local server (Windows defaults to the Responses API)
# Start the server in LM Studio's Developer tab; port 1234 is the default.
# LM_STUDIO_URL=http://localhost:1234
# LM_STUDIO_API_KEY=lm-studio
# Optional: set a specific model ID returned by /v1/models.
# LM_STUDIO_MODEL=
